# ============================================================
# APP_MODE 하나로 두 가지 배포 형태를 가른다.
#   local : 내 PC 의 llama-server. 로그인도 DB 도 없다.
#   cloud : 웹 배포. Google 로그인 + 회원별 Gemini API 키.
# ============================================================
APP_MODE=local

# ---------- local 모드 ----------
# llama-server 의 OpenAI 호환 엔드포인트 (/v1 까지 포함)
LLM_BASE_URL=http://127.0.0.1:8080/v1
# llama-server 의 --alias 값. 지정하지 않았다면 아무 값이나 넣어도 된다
LLM_MODEL=local-model
# llama-server 를 --api-key 로 띄운 경우에만 채운다
LLM_API_KEY=
# 긴 문단은 로컬 모델에서 수 분이 걸릴 수 있다
LLM_TIMEOUT=300
# Qwen3 등 reasoning 모델의 사고 과정 사용 여부.
# true 로 켜면 사고가 max_tokens 를 함께 소진하므로 16384 이상으로 올려야 한다.
LLM_ENABLE_THINKING=false
# json_schema | json_object | none
LLM_JSON_MODE=json_schema

# ---------- 공통 ----------
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- cloud 모드 ----------
# 호출은 회원이 등록한 키로 이뤄진다. 서버 공용 키는 두지 않는다.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=120

# Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth 콜백이 돌아올 백엔드 주소 (승인된 리디렉션 URI 에 등록할 값의 앞부분)
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 로그인 후 사용자를 돌려보낼 프론트엔드 주소
FRONTEND_BASE_URL=http://localhost:5173

# 세션 쿠키 서명 키. 32자 이상. 예: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# 회원 Gemini 키 암호화용 Fernet 키.
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Neon/Supabase 가 주는 Postgres URL. 비우면 로컬 SQLite 파일을 쓴다.
DATABASE_URL=sqlite+pysqlite:///./eng_study.db

# 회원 한 사람의 하루 한도. 분석 1회 = LLM 호출 4회임에 유의.
DAILY_ANALYSIS_LIMIT=60
DAILY_PRACTICE_LIMIT=200
