# llama-server 의 OpenAI 호환 엔드포인트 (/v1 까지 포함)
LLM_BASE_URL=http://127.0.0.1:8080/v1
# llama-server 의 --alias 값. 지정하지 않았다면 아무 값이나 넣어도 된다
LLM_MODEL=local-model
# llama-server 를 --api-key 로 띄운 경우에만 채운다
LLM_API_KEY=
# 긴 문단은 로컬 모델에서 수 분이 걸릴 수 있다
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
# Qwen3 등 reasoning 모델의 사고 과정 사용 여부.
# true 로 켜면 사고가 max_tokens 를 함께 소진하므로 16384 이상으로 올려야 한다.
LLM_ENABLE_THINKING=false
# json_schema | json_object | none
LLM_JSON_MODE=json_schema

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
